# Android build placeholders only. The app receives no provider credentials.
# Backend endpoint is public routing metadata, not a secret.
UNIGIG_BACKEND_URL=https://api.example.invalid/
# Secrets are resolved server-side through OpenBao references.
GEMINI_API_KEY=OPENBAO_REF:secret/data/unigig/gemini
STRIPE_PUBLISHABLE_KEY=BACKEND_TOKENIZATION_ONLY
STRIPE_SECRET_KEY=OPENBAO_REF:secret/data/unigig/stripe
